# Copy this file to .env for local runs (never commit .env).
# PowerShell:  Copy-Item .env.example .env   then edit .env in Notepad.

# ---- Web app (Phase 1) ----
# Long random string that signs the login cookie. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Google accounts allowed to sign in (comma-separated). Everyone else gets 403.
ALLOWED_EMAILS=pravendalal@gmail.com
# From Google Cloud Console > APIs & Services > Credentials > your "Web application" OAuth client.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Where the app runs. Google redirects back to  BASE_URL/auth/callback  (add that URI to the OAuth client).
BASE_URL=http://localhost:8000
GOOGLE_CLOUD_PROJECT=yt-auto-uploader
# Local Firestore emulator. Remove this line to use the real Firestore database.
FIRESTORE_EMULATOR_HOST=localhost:8080
# Keeps uploads private + shows a banner until the YouTube API audit is approved.
AUDIT_APPROVED=false
# Shown on /privacy and /terms (defaults to the first ALLOWED_EMAILS address).
CONTACT_EMAIL=
# Secret for the daily database keep-alive call to /healthz/db (header X-Ping-Token). Empty = disabled.
PING_TOKEN=
TZ=Asia/Kolkata

# ---- Later phases (not used yet) ----
REGION=asia-south1
GCS_BUCKET=
FERNET_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
WORKER_JOB_NAME=worker

# ---- Existing CLI uploader (src/uploader.py) ----
SHEET_ID=paste-the-long-id-from-the-google-sheet-url
DRIVE_FOLDER_ID=paste-the-id-from-the-YouTube-Uploads-folder-url
